# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
#
# MOCK mode needs NONE of this. `uv run demo act1..act4` works with no .env at
# all, offline, with no Azure account. Everything below is for LIVE.

# ---------------------------------------------------------------------------
# The only two switches in the demo
# ---------------------------------------------------------------------------
# mock = offline, deterministic, scripted planner, local toolbox, mock identity.
# live = Foundry model deployment, Foundry Toolbox, Entra, Azure Monitor.
DEMO_MODE=mock

# middleware = Agent Framework FunctionMiddleware (GA API). The stage default.
# hooks      = Agent Hooks, the AGENT-HOOKS-0.1 contract (experimental SDK).
# Both call the identical policy evaluator. Only the seam differs.
GOVERNANCE_ENGINE=middleware

# ---------------------------------------------------------------------------
# Telemetry (both modes)
# ---------------------------------------------------------------------------
ENABLE_INSTRUMENTATION=true
# Prompts, tool arguments and tool results in spans. Demo/dev only.
ENABLE_SENSITIVE_DATA=true
# Aspire Dashboard or Jaeger from docker-compose.yml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=helix-agent-governance
# Where the console links a decision's trace id.
TRACE_UI_URL=http://localhost:18888

# ---------------------------------------------------------------------------
# Governance runtime
# ---------------------------------------------------------------------------
# The governance console's port. Deliberately not 8000, which is the default
# for half the dev servers ever written and therefore the one most likely to
# be taken on the machine you present from.
CONSOLE_PORT=8787

AUDIT_DB=audit.db
# An `approve` decision that nobody answers within this many seconds is denied.
APPROVAL_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# LIVE: Microsoft Foundry
# ---------------------------------------------------------------------------
# Foundry project Overview -> project endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# A deployed chat-capable model, e.g. gpt-5.4-mini.
AZURE_AI_MODEL_DEPLOYMENT_NAME=<your-model-deployment-name>

# LIVE: Foundry Toolbox (PREVIEW). Set TOOLBOX_NAME and let the endpoint be
# derived, or set TOOLBOX_ENDPOINT explicitly to pin a specific version.
TOOLBOX_NAME=helix-clinical-tools
# Foundry namespaces re-published tools as <server_label>___<tool>, and it
# caches tool discovery per label. Each catalogue version gets its own label,
# `<prefix>_<version>`. See docs/LIVE_SETUP.md.
TOOLBOX_SERVER_LABEL_PREFIX=clinical_tools
# Consumer endpoint - always serves the toolbox's default_version:
#   {FOUNDRY_PROJECT_ENDPOINT}/toolboxes/{TOOLBOX_NAME}/mcp?api-version=v1
# Developer endpoint - pins one version, for testing before you promote it:
#   {FOUNDRY_PROJECT_ENDPOINT}/toolboxes/{TOOLBOX_NAME}/versions/{n}/mcp?api-version=v1
TOOLBOX_ENDPOINT=

# LIVE: Azure Monitor. Leave blank to have the Foundry project's own connection
# string configured automatically via FoundryChatClient.configure_azure_monitor().
APPLICATIONINSIGHTS_CONNECTION_STRING=

# How LIVE authenticates to Azure. The CLI credential is the default because
# `az login` is the demo case; false uses DefaultAzureCredential instead, for a
# deployment with a managed identity.
AZURE_USE_CLI_CREDENTIAL=true
# azure-identity allows `az account get-access-token` only 10 seconds, and a
# token refresh on a conference network can exceed that. It then fails with
# "Failed to invoke the Azure CLI", which reads like a broken install - it cost
# real debugging time here. Raised to 45s in governance/credentials.py; override
# if even that is tight.
AZURE_CLI_PROCESS_TIMEOUT=45

# ---------------------------------------------------------------------------
# LIVE: Entra agent identities
# ---------------------------------------------------------------------------
# Read these from the Foundry project's JSON view in the Azure portal (shared
# project identity) or from the published agent application's JSON view
# (distinct identity). They are object ids, not secrets.
#
# IMPORTANT: there is no client-side API to acquire a token *as* an agent
# identity. Foundry Agent Service performs the blueprint -> agent identity ->
# scoped token exchange. These ids are the governance claim this demo stamps on
# every span and audit row; they are not used to mint tokens locally.
# See docs/LIVE_SETUP.md.
# false lets LIVE run before any agent identity is provisioned; the identity
# is then labelled `unconfigured:<agent>`, which is visibly not an Entra id.
#
# Registering the agents is what creates these identities - Foundry mints one per
# external agent registration. Fill them in with:
#   uv run python infra/register_agents.py          # register, creating them
#   uv run python infra/register_agents.py --env    # print these three lines
REQUIRE_AGENT_IDENTITY=false
TRIAL_OPS_AGENT_IDENTITY_ID=
SAFETY_TRIAGE_AGENT_IDENTITY_ID=
SUPPLY_AGENT_IDENTITY_ID=

# ---------------------------------------------------------------------------
# A2A peers
# ---------------------------------------------------------------------------
# MOCK leaves these blank and starts a local canned-answer A2A server instead.
# LIVE also needs the clinical-tools MCP server to be publicly reachable
# before Foundry can discover it - see docs/LIVE_SETUP.md.
CLINICAL_TOOLS_PUBLIC_URL_V1=
CLINICAL_TOOLS_PUBLIC_URL_V2=
EXTERNAL_CRO_A2A_URL=
UNKNOWN_VENDOR_A2A_URL=

# ---------------------------------------------------------------------------
# Debugging
# ---------------------------------------------------------------------------
# 1 restores MCP/httpx/uvicorn INFO logging that the acts otherwise silence.
DEMO_VERBOSE=0
